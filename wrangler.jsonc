{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "public-health-repo-auditor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Audit-run history for Phase 6 (trend lines, org-wide fleet audits,
  // badges). `wrangler d1 migrations apply DB --remote` still needs to
  // be run once against this real database before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ph-repo-auditor-runs",
      "database_id": "50387356-d63a-4ef3-85d9-463cceceac79",
      "migrations_dir": "migrations"
    }
  ]
}
