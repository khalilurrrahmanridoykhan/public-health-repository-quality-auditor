{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "public-health-repo-auditor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Audit-run history for Phase 6 (trend lines, org-wide fleet audits,
  // badges). This repo doesn't provision the real D1 database for you —
  // run `wrangler d1 create ph-repo-auditor-runs`, replace database_id
  // below with the id it prints, then `wrangler d1 migrations apply DB
  // --remote` before deploying. `wrangler d1 migrations apply DB --local`
  // (no login needed) is enough for local dev.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ph-repo-auditor-runs",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ]
}
